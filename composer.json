{
    "name": "pepperfm/ip-nva",
    "type": "project",
    "description": "Тестовое задание: реферальные роуты",
    "require": {
        "php": "^8.5",
        "laravel/framework": "^13.0",
        "laravel/tinker": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "friendsofphp/php-cs-fixer": "^3.95",
        "larastan/larastan": "^3.12",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2",
        "laravel/pao": "^1.1",
        "laravel/pint": "^1.32",
        "laravel/sail": "^1.68",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "pepperfm/ai-guidelines": "^1.5",
        "pestphp/pest": "^5.2",
        "pestphp/pest-plugin-agent": "^5.0",
        "pestphp/pest-plugin-laravel": "^5.0",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "files": [
            "app/helpers.php"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php artisan package:discover --ansi"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "8.5"
        },
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
